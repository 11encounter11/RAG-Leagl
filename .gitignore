# ===== Data =====
# data/raw/: 原始语料, 体积大且可重新下载, 不入库
data/raw/
# data/eval/: **必须入库** —— 评测集是人工标注的标准答案, 属于源代码级资产,
# 不是"可再生的数据"。它被忽略过一次, 结果是 T-18"纳入 git 版本管理"
# 这条验收标准实际未达成, 而 git status 看起来是干净的。
# 只有运行产物 reports/ 忽略。
data/eval/reports/

# ===== Docker Volumes =====
mysql_data/
redis_data/
etcd_data/
minio_data/
milvus_data/

# ===== Logs =====
*.log

# ===== 一次性验收产物 =====
# e2e_q*.json 是 2026-09-22 那次端到端验收手工留下的响应快照, 与当前语料已对不上,
# 保留只为查历史。移到 data/eval/reports/legacy-e2e/ 下随报告一起忽略。
e2e_*.json
