# ============================================================
# 个人法律知识问答助手 - 环境变量示例
# 复制为 .env 后填写：cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略（tests/test_no_secrets.py 会强制检查这一点）。
# 所有键的默认值与 app/config/settings.py 保持一致，不写 .env 也能起服务。
# ============================================================

# ===== LLM / Embedding API Key（必填）=====
# 智谱开放平台，专供 embedding-3 向量模型
ZHIPU_API_KEY=
# DeepSeek，供查询改写 / 反思 / 生成
DEEPSEEK_API_KEY=

# ===== MySQL（对话与条文元数据）=====
# 端口 3307 是 docker-compose.yml 映射到宿主机的端口，容器内仍是 3306
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password
# 必须与 docker-compose.yml 的建库名一致，改成别的值会在启动时连不上
MYSQL_DATABASE=legal_rag

# ===== Redis（查询改写/反思结果缓存）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Milvus（向量库）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_base

# ===== 检索与切分 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
BM25_TOP_K=10
RERANK_TOP_N=5
# 名字叫"相似度阈值"，实际比的是 Cross-Encoder 归一化后的相关度分（0~1），
# 判的是"这一批候选值不值得答"（只看第 1 名），不是每条片段的及格线。
# 数值来自评测集标定，换语料/换嵌入模型后必须重标，见 docs/07 与 docs/09。
SIMILARITY_THRESHOLD=0.1

# ===== 重排器（BAAI/bge-reranker-base，本地 CPU 推理）=====
RERANK_MODEL=BAAI/bge-reranker-base
# float32 加载约 1GB 常驻内存；内存紧张时改 float16 / bfloat16
RERANK_TORCH_DTYPE=float32
# torch / onnx / openvino（后两者需要模型已导出为对应格式）
RERANK_BACKEND=torch
# 上游返回的是原始 logits 还是已经过 sigmoid 的概率
RERANK_SCORE_IS_LOGIT=false
# 一次性最多精排多少条候选（刻意取大值，由调用方自行截断）
RERANK_CANDIDATE_LIMIT=50
# 默认 true：只读本地模型缓存，不发网络请求。
# 设为 false 首次会去 huggingface.co 下载；国内网络下"启动卡住几分钟"通常是这里。
HF_HUB_OFFLINE=true

# ===== 拒答闸门（独立于重排器的安全底线）=====
ENABLE_DOMAIN_GATE=true
# 向量检索的最高原始相似度低于此值 → 判定为知识库外，直接拒答
DOMAIN_SCORE_REJECT=0.345
# 低于此值但高于 REJECT → 照常回答，但标记低置信并提示核对
DOMAIN_SCORE_CAUTION=0.36

# ===== Agentic 工作流 =====
# 开关关掉后工作流真的不执行对应节点，不是"前端不传参"那种伪生效
ENABLE_AGENTIC_RAG=true
ENABLE_QUERY_REWRITE=true
# HyDE 成本高、收益尚未被评测验证，默认关
ENABLE_HYDE=false
ENABLE_RERANK=true
ENABLE_CITATION_VERIFY=true
# 时效过滤：把 validity_status == "effective" 下推进 Milvus 查询表达式
ENABLE_VALIDITY_FILTER=true
REFLECTION_THRESHOLD=0.6
MAX_RETRIES=2
QUERY_REWRITE_MODEL=deepseek-v4.1-flash
HYDE_MODEL=deepseek-v4.1-flash
REFLECTION_MODEL=deepseek-v4.1-flash

# ===== Embedding =====
# 死配置：没有任何代码读取它。实际模型名在 app/core/rag/embedder.py 里硬编码为
# embedding-3（智谱）。改这里不会生效，别把它当开关用。
EMBEDDING_MODEL_NAME=embedding-3
# 0 = 从嵌入模型实际输出自动探测维度（智谱 embedding-3 实际返回 1024 维）。
# 只有需要跨环境锁死维度时才显式赋值。
EMBEDDING_DIM=0

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
DEBUG=true
# 逗号分隔。不要用 "*"：与 allow_credentials 组合会被浏览器拒绝
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
