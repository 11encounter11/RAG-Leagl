* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.toml text eol=lf

# Windows 上开发的人，脚本必须留 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制：绝不允许被换行符转换破坏
*.docx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
